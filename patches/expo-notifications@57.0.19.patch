-  func appendPendingResponse(_ response: UNNotificationResponse) {
-    state.withLock { $0.pendingResponses.append(response) }
+  /**
+   Records the response as pending and returns the delegates to offer it to, in one step: a
+   delegate that registers while the response is being delivered is offered it as pending.
+   */
+  func deliver(_ response: UNNotificationResponse) -> [NotificationDelegate] {
+    state.withLock { state in
+      state.pendingResponses.append(response)
+      return state.delegates
+    }
   }
 
-  func removeAllPendingResponses() {
-    state.withLock { $0.pendingResponses.removeAll() }
+  /**
+   Removes only the given responses: a response that arrived while these were being offered stays
+   pending.
+   */
+  func removePendingResponses(_ responses: [UNNotificationResponse]) {
+    state.withLock { state in
+      state.pendingResponses.removeAll { pending in responses.contains { $0 === pending } }
+    }
   }
 }
 
