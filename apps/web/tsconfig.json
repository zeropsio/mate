{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "erasableSyntaxOnly": false,
    "verbatimModuleSyntax": false,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "paths": {
      "~/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        // Diagnostic severities are deep-merged with tsconfig.base.json; list only web-specific overrides here.
        "diagnosticSeverity": {
          "globalDate": "off",
          "globalConsole": "off",
          "globalRandom": "off",
          "globalTimers": "off",
          "globalFetch": "off"
        }
      }
    ]
  },
  "exclude": ["test/scenarios", "test/engine-oracle"],
  "files": [
    "test/scenarios/fakes/fakeClock.ts",
    "test/scenarios/fakes/zerops.ts",
    "test/scenarios/fakes/zeropsDeviceLogin.ts",
    "test/scenarios/fakes/zeropsWorld.ts",
    "test/scenarios/fakes/zeropsWrites.ts",
    "test/scenarios/harness/clientClock.ts",
    "test/scenarios/harness/completedHttp.ts",
    "test/scenarios/harness/coreSeed.ts",
    "test/scenarios/harness/fakeWorld.ts",
    "test/scenarios/harness/http.ts",
    "test/scenarios/harness/httpCall.ts"
  ],
  "include": [
    "src",
    "vite.config.ts",
    "test",
    "scripts/warm-dep-cache.ts",
    "../../scripts/lib/public-config.ts"
  ]
}
