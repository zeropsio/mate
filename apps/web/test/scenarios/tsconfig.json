{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "module": "Preserve",
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "globalDate": "off",
          "globalTimers": "off",
          "globalFetch": "off",
          "globalConsole": "off"
        }
      }
    ]
  },
  "include": ["**/*.ts"]
}
