          "id": "0",
          "name": "relaySigning > canonicalizes object keys recursively",
          "location": { "start": { "column": 3, "line": 6 } }
        }
      ],
      "source": "import { describe, expect, it } from \"@effect/vitest\";\n\nimport { stableStringify } from \"./relaySigning.ts\";\n\ndescribe(\"relaySigning\", () => {\n  it(\"canonicalizes object keys recursively\", () => {\n    expect(\n      stableStringify({\n        z: 1,\n        a: {\n          y: true,\n          b: null,\n        },\n        list: [{ c: \"three\", a: \"one\" }],\n      }),\n    ).toBe('{\"a\":{\"b\":null,\"y\":true},\"list\":[{\"a\":\"one\",\"c\":\"three\"}],\"z\":1}');\n  });\n});\n"
    }
